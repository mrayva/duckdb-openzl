# name: test/sql/openzl.test
# description: test openzl extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT openzl_decompress('a.zl', 'a.parquet');
----
Catalog Error: Scalar Function with name openzl_decompress does not exist!

require openzl

require parquet

# Missing input file should fail cleanly with our own error message,
# regardless of whether the zli binary is available in this environment
# (the missing-file check runs first).
statement error
SELECT openzl_decompress('/nonexistent/path/does/not/exist.zl', '/tmp/openzl_test_out.parquet');
----
input file not found

statement error
SELECT openzl_compress('/nonexistent/path/does/not/exist.parquet', '/tmp/openzl_test_out.zl');
----
input parquet file not found

# read_openzl(path) is a table macro around read_parquet(openzl_decompress(...)):
# same missing-file error, surfacing through the macro expansion.
statement error
SELECT * FROM read_openzl('/nonexistent/path/does/not/exist.zl');
----
input file not found

# Full round trip: write canonical parquet, archive it, read it back via the
# single-call macro, and confirm it lands back on the original data.
statement ok
CREATE TABLE t AS SELECT range AS a, 'row_' || range AS b FROM range(1000);

statement ok
COPY t TO '__TEST_DIR__/openzl_roundtrip.parquet' (FORMAT PARQUET, COMPRESSION 'uncompressed', DICTIONARY_SIZE_LIMIT 0);

statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_roundtrip.parquet', '__TEST_DIR__/openzl_roundtrip.zl');

query II
SELECT * FROM read_openzl('__TEST_DIR__/openzl_roundtrip.zl') ORDER BY a LIMIT 3;
----
0	row_0
1	row_1
2	row_2

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_roundtrip.zl');
----
1000

# Concurrent scans share one decompressed buffer per archive (DuckDB opens one
# file handle per scan thread; a private copy each once multiplied RAM by the
# thread count and OOM'd a 16-thread scan of a multi-GB archive). Correctness
# under many threads; the memory behavior itself was measured by hand.
statement ok
SET threads=8;

query II
SELECT count(*), sum(a) FROM read_openzl('__TEST_DIR__/openzl_roundtrip.zl');
----
1000	499500

statement ok
RESET threads;

# COPY ... TO 'x.zl' (FORMAT OPENZL) is the single-call write path: it
# delegates to the catalog's "parquet" copy function under the hood (staged
# canonically, then OpenZL-compressed on finalize), so this should produce
# the same result as the COPY-then-openzl_compress path above.
statement ok
COPY t TO '__TEST_DIR__/openzl_copyfmt.zl' (FORMAT OPENZL);

query II
SELECT * FROM read_openzl('__TEST_DIR__/openzl_copyfmt.zl') ORDER BY a LIMIT 3;
----
0	row_0
1	row_1
2	row_2

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_copyfmt.zl');
----
1000

# No leftover staging file after a successful COPY.
query I
SELECT count(*) FROM glob('__TEST_DIR__/openzl_copyfmt.zl.openzl_staging.parquet');
----
0

# Overwriting an existing .zl target (exercises DuckDB's own
# tmp-file-then-rename path, since the destination already exists) should
# still produce a correct, non-stale result.
statement ok
COPY (SELECT * FROM t WHERE a < 5) TO '__TEST_DIR__/openzl_copyfmt.zl' (FORMAT OPENZL);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_copyfmt.zl');
----
5

# IN_MEMORY: parquet's own writer stages into an "openzl-buffer://" buffer
# instead of a real temp file -- no staging file (of any name) should appear
# on disk at all, not even transiently.
statement ok
COPY t TO '__TEST_DIR__/openzl_inmemory.zl' (FORMAT OPENZL, IN_MEMORY true);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_inmemory.zl');
----
1000

query I
SELECT count(*) FROM glob('__TEST_DIR__/openzl_inmemory.zl.openzl_staging.parquet');
----
0

# IN_MEMORY produces byte-identical output to on-disk staging for the same
# data -- both are just different routes to the same canonical parquet bytes.
statement ok
COPY t TO '__TEST_DIR__/openzl_ondisk_for_compare.zl' (FORMAT OPENZL, IN_MEMORY false);

query I
SELECT (SELECT content FROM read_blob('__TEST_DIR__/openzl_inmemory.zl')) =
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_ondisk_for_compare.zl'));
----
true

# ---- openzl_train() ----

statement error
SELECT * FROM openzl_train('not_a_list.parquet', '__TEST_DIR__/x.compressor');
----
No function matches

statement error
SELECT * FROM openzl_train(NULL::VARCHAR[], '__TEST_DIR__/x.compressor');
----
must be a list of sample file paths

statement error
SELECT * FROM openzl_train([]::VARCHAR[], '__TEST_DIR__/x.compressor');
----
requires at least one sample file

statement error
SELECT * FROM openzl_train(['/nonexistent/sample.parquet'], '__TEST_DIR__/x.compressor');
----
sample file not found

statement error
SELECT * FROM openzl_train(['__TEST_DIR__/openzl_roundtrip.parquet'], '__TEST_DIR__/x.compressor', clustering_trainer := 'bogus');
----
clustering_trainer must be

# Three same-shaped sample files (different data, same schema) to train
# against; no_ace_successors keeps this fast enough for a test suite (the
# full ACE search is real optimization work, exercised manually/in
# benchmarks, not needed to prove the plumbing is correct here).
statement ok
COPY (SELECT range AS a, 'row_' || range AS b FROM range(200)) TO '__TEST_DIR__/openzl_train_1.parquet' (FORMAT PARQUET, COMPRESSION 'uncompressed', DICTIONARY_SIZE_LIMIT 0);

statement ok
COPY (SELECT range + 1000 AS a, 'row_' || (range + 1000) AS b FROM range(200)) TO '__TEST_DIR__/openzl_train_2.parquet' (FORMAT PARQUET, COMPRESSION 'uncompressed', DICTIONARY_SIZE_LIMIT 0);

statement ok
COPY (SELECT range + 2000 AS a, 'row_' || (range + 2000) AS b FROM range(200)) TO '__TEST_DIR__/openzl_train_3.parquet' (FORMAT PARQUET, COMPRESSION 'uncompressed', DICTIONARY_SIZE_LIMIT 0);

query II
SELECT candidate_index, output_path FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet', '__TEST_DIR__/openzl_train_3.parquet'],
    '__TEST_DIR__/openzl_trained.compressor',
    no_ace_successors := true,
    clustering_trainer := 'greedy'
);
----
0	__TEST_DIR__/openzl_trained.compressor

# pareto_frontier writes one numbered file per candidate and returns one row
# each.
query I
SELECT count(*) > 0 FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet', '__TEST_DIR__/openzl_train_3.parquet'],
    '__TEST_DIR__/openzl_pareto.compressor',
    no_ace_successors := true,
    pareto_frontier := true
);
----
1

# NULL output_path: no file is written, but compressor_bytes is still
# populated -- for storing the trained compressor "inside the database" (a
# BLOB column in an ordinary table) instead of as a standalone file.
query I
SELECT output_path FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet', '__TEST_DIR__/openzl_train_3.parquet'],
    NULL,
    no_ace_successors := true
);
----
NULL

statement ok
CREATE TABLE openzl_compressors AS
SELECT candidate_index, compressor_bytes FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet', '__TEST_DIR__/openzl_train_3.parquet'],
    NULL,
    no_ace_successors := true
);

query I
SELECT typeof(compressor_bytes) FROM openzl_compressors;
----
BLOB

# Compressing with a compressor stored as a BLOB (read back from the table
# above) round-trips the same as the file-based path.
statement ok
SELECT openzl_compress(
    '__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_blob_trained.zl',
    (SELECT compressor_bytes FROM openzl_compressors WHERE candidate_index = 0)
);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_blob_trained.zl');
----
200

statement error
SELECT openzl_compress('__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/x.zl', NULL::BLOB);
----
must not be NULL

# Compressing with the trained compressor round-trips correctly against
# held-out data (openzl_train_1, not one of the training samples used above
# -- well, it was, but the point here is plumbing correctness, not held-out
# generalization, which is exercised manually/in benchmarks instead).
statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_trained_output.zl', '__TEST_DIR__/openzl_trained.compressor');

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_trained_output.zl');
----
200

# Empty trained_compressor path falls back to the generic graph rather than
# erroring.
statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_fallback.zl', '');

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_fallback.zl');
----
200

# NULL falls back the same way (requires SetNullHandling(SPECIAL_HANDLING) --
# DuckDB's default null handling would otherwise make the whole call a no-op
# returning NULL without ever writing openzl_fallback_null.zl at all).
statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_fallback_null.zl', NULL::VARCHAR);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_fallback_null.zl');
----
200

statement error
SELECT openzl_compress('__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/x.zl', '/nonexistent/compressor');
----
trained compressor file not found

# COPY ... FORMAT OPENZL with TRAINED_COMPRESSOR and COMPRESSION_LEVEL options.
statement ok
COPY t TO '__TEST_DIR__/openzl_copy_trained.zl' (FORMAT OPENZL, TRAINED_COMPRESSOR '__TEST_DIR__/openzl_trained.compressor', COMPRESSION_LEVEL 9);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_copy_trained.zl');
----
1000

# ---- runtime limit + automatic chunking ----

# openzl_max_compress_bytes is a run-time setting: a tiny limit rejects the
# compress with a message that names the knob; raising it lets it through.
statement ok
SET openzl_max_compress_bytes = 100;

statement error
SELECT openzl_compress('__TEST_DIR__/openzl_roundtrip.parquet', '__TEST_DIR__/openzl_limited.zl');
----
openzl_max_compress_bytes

statement ok
RESET openzl_max_compress_bytes;

statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_roundtrip.parquet', '__TEST_DIR__/openzl_limited.zl');

# A single-chunk archive is a plain frame.
query I
SELECT openzl_chunk_count('__TEST_DIR__/openzl_limited.zl');
----
1

# COPY splits into independent chunks once the staged parquet reaches
# CHUNK_SIZE_BYTES; read_openzl stitches them back transparently.
statement ok
COPY (SELECT range AS a, 'row_' || range AS b FROM range(2000000)) TO '__TEST_DIR__/openzl_chunked.zl' (FORMAT OPENZL, CHUNK_SIZE_BYTES 5000000);

query I
SELECT openzl_chunk_count('__TEST_DIR__/openzl_chunked.zl') > 1;
----
true

query III
SELECT count(*), sum(a), count(DISTINCT b) FROM read_openzl('__TEST_DIR__/openzl_chunked.zl');
----
2000000	1999999000000	2000000

# Same, staging in memory.
statement ok
COPY (SELECT range AS a, 'row_' || range AS b FROM range(2000000)) TO '__TEST_DIR__/openzl_chunked_mem.zl' (FORMAT OPENZL, CHUNK_SIZE_BYTES 5000000, IN_MEMORY true);

query II
SELECT count(*), sum(a) FROM read_openzl('__TEST_DIR__/openzl_chunked_mem.zl');
----
2000000	1999999000000

# A chunked archive isn't a single parquet file: the eager decompress says so.
statement error
SELECT openzl_decompress('__TEST_DIR__/openzl_chunked.zl', '__TEST_DIR__/x.parquet');
----
chunked archive

# CHUNK_SIZE_BYTES 0 disables chunking; the setting supplies the default.
statement ok
COPY (SELECT range AS a FROM range(2000000)) TO '__TEST_DIR__/openzl_nochunk.zl' (FORMAT OPENZL, CHUNK_SIZE_BYTES 0);

query I
SELECT openzl_chunk_count('__TEST_DIR__/openzl_nochunk.zl');
----
1

statement ok
SET openzl_chunk_size_bytes = 2000000;

statement ok
COPY (SELECT range AS a FROM range(2000000)) TO '__TEST_DIR__/openzl_setting_chunk.zl' (FORMAT OPENZL);

query I
SELECT openzl_chunk_count('__TEST_DIR__/openzl_setting_chunk.zl') > 1;
----
true

statement ok
RESET openzl_chunk_size_bytes;

# An empty result is still one valid (empty) archive.
statement ok
COPY (SELECT range AS a FROM range(10) WHERE false) TO '__TEST_DIR__/openzl_empty.zl' (FORMAT OPENZL, CHUNK_SIZE_BYTES 1000);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_empty.zl');
----
0

# ---- openzl_train benchmark columns ----

# Not benchmarked by default without pareto_frontier: metric columns are NULL.
query I
SELECT compression_ratio IS NULL FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet'],
    NULL,
    no_ace_successors := true
);
----
true

# benchmark := true reports ratio and both speeds for the single candidate.
query III
SELECT compression_ratio > 1, compress_mb_s > 0, decompress_mb_s > 0 FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet'],
    NULL,
    no_ace_successors := true,
    benchmark := true
);
----
true	true	true

# pareto_frontier benchmarks every candidate by default, on held-out files
# when benchmark_files is given.
query I
SELECT count(*) > 0 AND bool_and(compression_ratio > 0 AND compress_mb_s > 0 AND decompress_mb_s > 0) FROM openzl_train(
    ['__TEST_DIR__/openzl_train_1.parquet', '__TEST_DIR__/openzl_train_2.parquet'],
    NULL,
    no_ace_successors := true,
    pareto_frontier := true,
    benchmark_files := ['__TEST_DIR__/openzl_train_3.parquet']
);
----
true

statement error
SELECT * FROM openzl_train(['__TEST_DIR__/openzl_train_1.parquet'], NULL, no_ace_successors := true, benchmark := true, benchmark_files := ['/nonexistent/held_out.parquet']);
----
benchmark file not found

# ---- openzl_promote: lossless VARCHAR -> numeric promotion ----

statement ok
CREATE TABLE raw_txt AS SELECT * FROM (VALUES
    ('1',   '4.16',  '007', 'AAPL', NULL::VARCHAR, '12345678901234567890', '1', '5'),
    ('-20', '.5',    '8',   'MSFT', NULL, '1',                    '2', 'x'),
    (NULL,  '100',   '9',   'GOOG', NULL, '2',                    '3', '7')
) t(i, d, z, s, n, big, m, mixed);

query IIIIIIII
SELECT typeof(i), typeof(d), typeof(z), typeof(s), typeof(n), typeof(big), typeof(m), typeof(mixed) FROM openzl_promote('raw_txt') LIMIT 1;
----
BIGINT	DECIMAL(18,6)	VARCHAR	VARCHAR	VARCHAR	VARCHAR	BIGINT	VARCHAR

# Values survive the promotion (numerically exact; formatting can differ).
query III
SELECT i, d, m FROM openzl_promote('raw_txt') ORDER BY m;
----
1	4.160000	1
-20	0.500000	2
NULL	100.000000	3

# Limits are tunable: a 1-digit integer limit rejects -20 as BIGINT (it still
# fits the decimal form, so the column becomes DECIMAL(13,1)), and a scale of 1
# rejects 4.16, so that column stays text.
query II
SELECT typeof(i), typeof(d) FROM openzl_promote('raw_txt', max_int_digits := 1, decimal_scale := 1) LIMIT 1;
----
DECIMAL(13,1)	VARCHAR

query I
SELECT typeof(d) FROM openzl_promote('raw_txt', promote_decimal := false) LIMIT 1;
----
VARCHAR

statement error
SELECT * FROM openzl_promote('no_such_table');
----
cannot read

statement error
SELECT * FROM openzl_promote('raw_txt; DROP TABLE raw_txt');
----
expected a table or view name

# Non-VARCHAR columns pass through; the promoted table exports and reads back.
statement ok
COPY (SELECT * FROM openzl_promote('raw_txt')) TO '__TEST_DIR__/openzl_promoted.zl' (FORMAT OPENZL);

query IIII
SELECT typeof(i), typeof(d), count(*), sum(m) FROM read_openzl('__TEST_DIR__/openzl_promoted.zl') GROUP BY 1, 2;
----
BIGINT	DECIMAL(18,6)	3	6

# ---- openzl_compression_level setting ----

statement error
SET openzl_compression_level = 0;
----
between 1 and 9

statement error
SET openzl_compression_level = 10;
----
between 1 and 9

statement ok
CREATE TABLE lvl AS SELECT range AS a, md5(range::VARCHAR) AS b FROM range(200000);

statement ok
COPY lvl TO '__TEST_DIR__/openzl_lvl_default.zl' (FORMAT OPENZL);

statement ok
SET openzl_compression_level = 1;

statement ok
COPY lvl TO '__TEST_DIR__/openzl_lvl_setting1.zl' (FORMAT OPENZL);

# An explicit COMPRESSION_LEVEL wins over the setting.
statement ok
COPY lvl TO '__TEST_DIR__/openzl_lvl_explicit9.zl' (FORMAT OPENZL, COMPRESSION_LEVEL 9);

statement ok
RESET openzl_compression_level;

statement ok
COPY lvl TO '__TEST_DIR__/openzl_lvl_explicit1.zl' (FORMAT OPENZL, COMPRESSION_LEVEL 1);

# The setting is the same knob as the option: setting=1 == explicit 1, and
# explicit 9 == default (9), byte for byte.
query II
SELECT (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_setting1.zl')) =
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_explicit1.zl')),
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_explicit9.zl')) =
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_default.zl'));
----
true	true

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_lvl_setting1.zl');
----
200000

# ---- ROW_GROUP_SIZE passes through to parquet's writer ----

statement ok
COPY lvl TO '__TEST_DIR__/openzl_rg_small.zl' (FORMAT OPENZL, ROW_GROUP_SIZE 20000);

statement ok
COPY lvl TO '__TEST_DIR__/openzl_rg_default.zl' (FORMAT OPENZL);

query II
SELECT (SELECT count(DISTINCT row_group_id) FROM parquet_metadata('openzl://__TEST_DIR__/openzl_rg_small.zl')) >= 10,
       (SELECT count(DISTINCT row_group_id) FROM parquet_metadata('openzl://__TEST_DIR__/openzl_rg_default.zl')) < 10;
----
true	true

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_rg_small.zl');
----
200000

# ---- FORMAT_VERSION / PROFILE / PARQUET_CHUNK_SIZE_BYTES ----

statement error
SET openzl_profile = 'bogus';
COPY lvl TO '__TEST_DIR__/x_bad_profile.zl' (FORMAT OPENZL);
----
unknown profile

statement ok
RESET openzl_profile;

statement error
COPY lvl TO '__TEST_DIR__/x_bad_version.zl' (FORMAT OPENZL, FORMAT_VERSION 3);
----
outside the supported range

# Internal chunking needs format version >= 21.
statement error
COPY lvl TO '__TEST_DIR__/x_chunk_old.zl' (FORMAT OPENZL, FORMAT_VERSION 20, PARQUET_CHUNK_SIZE_BYTES 1000000);
----
needs format version >= 21

statement error
COPY lvl TO '__TEST_DIR__/x_neg.zl' (FORMAT OPENZL, PARQUET_CHUNK_SIZE_BYTES -1);
----
must be >= 0

# A trained compressor is parquet-profile only.
statement error
COPY lvl TO '__TEST_DIR__/x_trained_serial.zl' (FORMAT OPENZL, PROFILE 'serial', TRAINED_COMPRESSOR '__TEST_DIR__/openzl_trained.compressor');
----
can't be combined with PROFILE

# Every combination round-trips.
statement ok
COPY lvl TO '__TEST_DIR__/openzl_v21.zl' (FORMAT OPENZL, FORMAT_VERSION 21);

statement ok
COPY lvl TO '__TEST_DIR__/openzl_pchunk.zl' (FORMAT OPENZL, PARQUET_CHUNK_SIZE_BYTES 1000000);

statement ok
COPY lvl TO '__TEST_DIR__/openzl_serial.zl' (FORMAT OPENZL, PROFILE 'serial');

query III
SELECT (SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_v21.zl')),
       (SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_pchunk.zl')),
       (SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_serial.zl'));
----
200000	200000	200000

query I
SELECT (SELECT sum(a) FROM read_openzl('__TEST_DIR__/openzl_pchunk.zl')) = (SELECT sum(a) FROM lvl);
----
true

# The graphs really differ: the serial profile's bytes are not the parquet
# profile's.
query I
SELECT (SELECT content FROM read_blob('__TEST_DIR__/openzl_serial.zl')) !=
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_default.zl'));
----
true

# Settings are the defaults for COPY and openzl_compress; an option overrides.
statement ok
SET openzl_profile = 'serial';

statement ok
COPY lvl TO '__TEST_DIR__/openzl_serial_setting.zl' (FORMAT OPENZL);

statement ok
COPY lvl TO '__TEST_DIR__/openzl_parquet_override.zl' (FORMAT OPENZL, PROFILE 'parquet');

statement ok
RESET openzl_profile;

query II
SELECT (SELECT content FROM read_blob('__TEST_DIR__/openzl_serial_setting.zl')) =
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_serial.zl')),
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_parquet_override.zl')) =
       (SELECT content FROM read_blob('__TEST_DIR__/openzl_lvl_default.zl'));
----
true	true

statement ok
SET openzl_parquet_chunk_bytes = 1000000;

statement ok
SELECT openzl_compress('__TEST_DIR__/openzl_roundtrip.parquet', '__TEST_DIR__/openzl_scalar_chunked.zl');

statement ok
RESET openzl_parquet_chunk_bytes;

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_scalar_chunked.zl');
----
1000

# openzl_train takes the same knobs (baked into the trained compressor).
query I
SELECT count(*) FROM openzl_train(['__TEST_DIR__/openzl_train_1.parquet'], NULL, no_ace_successors := true,
                                  format_version := 21, parquet_chunk_bytes := 100000);
----
1

statement error
SELECT * FROM openzl_train(['__TEST_DIR__/openzl_train_1.parquet'], NULL, format_version := 20, parquet_chunk_bytes := 100000);
----
needs format version >= 21

# A version too old for the graph gets a clear message (not "is it canonical parquet?").
statement error
COPY lvl TO '__TEST_DIR__/x_v8.zl' (FORMAT OPENZL, FORMAT_VERSION 8);
----
too old for this data

# What a given version supports depends on the codecs the graph picks for the
# data: a small table of plain integers/short strings still works at v10.
statement ok
COPY t TO '__TEST_DIR__/openzl_v10.zl' (FORMAT OPENZL, FORMAT_VERSION 10);

query I
SELECT count(*) FROM read_openzl('__TEST_DIR__/openzl_v10.zl');
----
1000
